# Ключ OpenAI API (обязательно): https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
# Модель должна быть доступна вашему аккаунту; меняется без правки кода
OPENAI_MODEL=gpt-4.1-mini

# Тайм-ауты (секунды)
REQUEST_TIMEOUT=15
OPENAI_TIMEOUT=60
# Общее число попыток при временных ошибках (сеть, 429, 5xx), включая первую
MAX_RETRIES=3

# Ограничения загружаемой страницы (байты) и текста для модели (символы)
MAX_PAGE_SIZE=2000000
MAX_TEXT_LENGTH=20000

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Необязательные параметры
# MAX_REDIRECTS=5
# Проверять доступность модели при запуске (true/false)
# VERIFY_MODEL_ON_STARTUP=true
